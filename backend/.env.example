# ========================================================
# LIFEGRID Environment Configuration
# ========================================================

PROJECT_NAME="LIFEGRID"
TAGLINE="Connect. Coordinate. Respond."
VERSION="1.0.0-SIH-PROTOTYPE"

# Secret Key for JWT token signing (Replace with secure 32+ char key in production)
SECRET_KEY="replace_with_a_super_secret_jwt_random_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL:
# SQLite (Local Prototype default):
DATABASE_URL="sqlite:///./lifegrid.db"
# PostgreSQL + PostGIS (Production):
# DATABASE_URL="postgresql://lifegrid_user:yourpassword@localhost:5432/lifegrid"

# Optional: Google Gemini API Key for extended generative summaries
GEMINI_API_KEY=""

# Grid Reference (New Delhi Central NCR default)
CITY_CENTER_LAT=28.6139
CITY_CENTER_LNG=77.2090
